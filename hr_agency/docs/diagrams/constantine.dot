digraph G { graph[fontname="DejaVu Sans", label="Структурная карта Константайна: модуль «Подбор кандидатов на вакансию»\nстрелка – вызов модуля; ○→ передача данных вниз, ←○ возврат данных; ● – управляющий флаг;\nдвойная рамка – библиотечный модуль; «Оценить соответствие» вызывается в цикле для каждого соискателя", labelloc=t, fontsize=18, pad=0.3, nodesep=0.5, ranksep=1.1];
node[fontname="DejaVu Sans", fontsize=12, shape=box, style=filled, fillcolor="#f3f6fb"]; edge[fontname="DejaVu Sans", fontsize=10];
M[label="Подобрать кандидатов\nна вакансию", fillcolor="#fff4e0"];
G1[label="Получить вакансию"]; G2[label="Получить список\nсоискателей"]; C[label="Оценить\nсоответствие"]; SR[label="Отсортировать\nпо баллам"]; SV[label="Сохранить\nподборку"]; PR[label="Вывести\nрезультат"];
C1[label="Сравнить\nнавыки"]; C2[label="Проверить\nопыт"]; C3[label="Проверить\nзарплату"]; C4[label="Проверить\nгород"];
DBM[label="Модуль доступа\nк данным", shape=box, peripheries=2, fillcolor="#eaf6ea"];
M -> G1 [label="○→ id вакансии\n←○ вакансия"]; M -> G2 [label="←○ соискатели"];
M -> C [label="○→ вакансия, соискатель\n←○ баллы  ←● годен?"]; M -> SR [label="○→ кандидаты\n←○ упорядоченный список"];
M -> SV [label="○→ подборка\n←● успех"]; M -> PR [label="○→ список"];
C -> C1 [label="○→ навыки\n←○ доля совпадений"]; C -> C2 [label="○→ опыт\n←● достаточно?"]; C -> C3 [label="○→ зп\n←● в бюджете?"]; C -> C4 [label="○→ город\n←● совпадает?"];
G1 -> DBM; G2 -> DBM; SV -> DBM;
}
