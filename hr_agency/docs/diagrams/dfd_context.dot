digraph G { rankdir=LR; graph[fontname="DejaVu Sans", label="Контекстная диаграмма потоков данных (DFD, уровень 0)", labelloc=t, fontsize=18, pad=0.3, nodesep=0.6, ranksep=1.3];
node[fontname="DejaVu Sans", fontsize=13]; edge[fontname="DejaVu Sans", fontsize=11];
A[label="Соискатель", shape=box, style="filled", fillcolor="#eeeeee"];
E[label="Работодатель", shape=box, style="filled", fillcolor="#eeeeee"];
R[label="Рекрутер", shape=box, style="filled", fillcolor="#eeeeee"];
H[label="Руководитель\nагентства", shape=box, style="filled", fillcolor="#eeeeee"];
P[label="0\nПК «Кадровое\nагентство»", shape=circle, style="filled", fillcolor="#dfe9f7", width=2.2, fixedsize=true];
A -> P [label="анкета, резюме"]; P -> A [label="предложения вакансий,\nприглашения на интервью"];
E -> P [label="заявка на вакансию,\nтребования"]; P -> E [label="подборка кандидатов"];
E -> P [label="обратная связь\nпо кандидату"];
R -> P [label="логин/пароль, этапы работы,\nкритерии поиска"]; P -> R [label="результаты поиска,\nсписки кандидатов"];
P -> H [label="отчёты: вакансии, кандидаты,\nэффективность рекрутеров"];
}
