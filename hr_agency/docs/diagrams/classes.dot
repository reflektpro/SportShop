digraph G { graph[fontname="DejaVu Sans", label="Диаграмма классов (концептуальная объектная модель)", labelloc=t, fontsize=18, pad=0.3, nodesep=0.5, ranksep=0.8];
node[shape=plaintext, fontname="DejaVu Mono", fontsize=10]; edge[fontname="DejaVu Sans", fontsize=10];
Person[label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="#f3f6fb"><tr><td bgcolor="#c9d8ef"><b>Person</b></td></tr><tr><td align="left">- _full_name: str<br align="left"/>- _phone: str<br align="left"/></td></tr><tr><td align="left" bgcolor="#e8eef7">«property» full_name, phone<br align="left"/>«property» short_name<br align="left"/></td></tr></table>>];
Applicant[label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="#f3f6fb"><tr><td bgcolor="#c9d8ef"><b>Applicant</b></td></tr><tr><td align="left">+ id, city, education<br align="left"/>+ experience: int<br align="left"/>+ skills: set[str]<br align="left"/>+ desired_salary: int<br align="left"/>+ email, resume_file<br align="left"/></td></tr></table>>];
Employer[label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="#f3f6fb"><tr><td bgcolor="#c9d8ef"><b>Employer</b> «dataclass»</td></tr><tr><td align="left">+ id, name, inn, city<br align="left"/>+ contact_person, phone, email<br align="left"/></td></tr><tr><td align="left" bgcolor="#e8eef7">__post_init__(): проверка ИНН<br align="left"/></td></tr></table>>];
Vacancy[label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="#f3f6fb"><tr><td bgcolor="#c9d8ef"><b>Vacancy</b></td></tr><tr><td align="left">+ id, title, city<br align="left"/>+ requirements: set[str]<br align="left"/>+ min_experience, salary<br align="left"/>+ opened, closed: date<br align="left"/>- _status: VacancyStatus<br align="left"/></td></tr><tr><td align="left" bgcolor="#e8eef7">«property» status (get/set)<br align="left"/>«property» is_open<br align="left"/></td></tr></table>>];
User[label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="#f3f6fb"><tr><td bgcolor="#c9d8ef"><b>User</b></td></tr><tr><td align="left">+ id, login, full_name<br align="left"/>+ role: Role<br align="left"/>- _salt, _hash<br align="left"/></td></tr><tr><td align="left" bgcolor="#e8eef7">check_password(p): bool<br align="left"/>can(action): bool<br align="left"/></td></tr></table>>];
Selection[label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="#f3f6fb"><tr><td bgcolor="#c9d8ef"><b>Selection</b> «dataclass»</td></tr><tr><td align="left">+ id, score, created<br align="left"/>+ stages: list[Stage]<br align="left"/></td></tr><tr><td align="left" bgcolor="#e8eef7">«property» current_stage<br align="left"/>add_stage(name, comment)<br align="left"/></td></tr></table>>];
Stage[label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="#f3f6fb"><tr><td bgcolor="#c9d8ef"><b>Stage</b> «dataclass»</td></tr><tr><td align="left">+ name, day, comment<br align="left"/></td></tr></table>>];
Agency[label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="#fdf3e1"><tr><td bgcolor="#f6d9a8"><b>Agency</b></td></tr><tr><td align="left">+ employers, vacancies, applicants<br align="left"/>+ users, selections, log<br align="left"/></td></tr><tr><td align="left" bgcolor="#fbe9cc">add_employer / add_vacancy / add_applicant / add_user<br align="left"/>login(login, password): User<br align="left"/>search_vacancies(...), search_applicants(...)<br align="left"/>score(vacancy, applicant): int  «static»<br align="left"/>match_candidates(vacancy, threshold=50)<br align="left"/>create_selection(user, vacancy, threshold)<br align="left"/>report_open_vacancies(), report_recruiters()<br align="left"/>export_selections_csv(path)<br align="left"/></td></tr></table>>];
Applicant -> Person [arrowhead=empty, label=" наследует"];
Agency -> Employer [dir=back, arrowtail=diamond, label="1..*"]; Agency -> Vacancy [dir=back, arrowtail=diamond, label="1..*"];
Agency -> Applicant [dir=back, arrowtail=diamond, label="1..*"]; Agency -> User [dir=back, arrowtail=diamond, label="1..*"]; Agency -> Selection [dir=back, arrowtail=diamond, label="0..*"];
Vacancy -> Employer [label="employer"]; Selection -> Vacancy [label="vacancy"]; Selection -> Applicant [label="applicant"]; Selection -> User [label="recruiter"];
Selection -> Stage [dir=back, arrowtail=diamond, label="0..6"];
}
