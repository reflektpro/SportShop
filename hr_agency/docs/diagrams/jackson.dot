digraph G { graph[fontname="DejaVu Sans", label="Структурная карта Джексона: обработка подбора кандидатов\nблоки одного уровня без знака – последовательность (слева направо);\n* – итерация (для каждого соискателя); o – выбор (выполняется одна из альтернатив)", labelloc=t, fontsize=18, pad=0.3, nodesep=0.3, ranksep=0.7, ordering=out];
node[fontname="DejaVu Sans", fontsize=12, shape=box, style=filled, fillcolor="#f3f6fb", width=1.6]; edge[arrowhead=none];
R[label="Подбор кандидатов", fillcolor="#fff4e0"];
A[label="Начало:\nзагрузить вакансию"]; B[label="Тело:\nобработать соискателей"]; C[label="Конец:\nсохранить и вывести"];
R -> A; R -> B; R -> C;
B -> B1; B1[label="Обработать\nсоискателя    *"];
B1 -> B2; B1 -> B3; B1 -> B4;
B2[label="Посчитать\nбаллы"]; B3[label="Решение по\nсоискателю"]; B4[label="Перейти\nк следующему"];
B3 -> D1; B3 -> D2; D1[label="Подходит       o\n(баллы ≥ порога)"]; D2[label="Не подходит   o"];
D1 -> E1; E1[label="Добавить\nв подборку"]; D2 -> E2; E2[label="Пропустить\n(записать причину)"];
B2 -> F1; B2 -> F2; B2 -> F3; F1[label="Навыки"]; F2[label="Опыт"]; F3[label="Зарплата\nи город"];
C -> C1; C -> C2; C -> C3; C1[label="Сортировка\nпо убыванию"]; C2[label="Запись\nподборки в БД"]; C3[label="Печать\nсписка"];
}
