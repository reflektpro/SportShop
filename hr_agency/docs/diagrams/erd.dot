digraph G { graph[fontname="DejaVu Sans", label="Диаграмма «сущность – связь» (ERD)", labelloc=t, fontsize=18, pad=0.3, nodesep=0.7, ranksep=0.9, rankdir=LR];
node[shape=plaintext, fontname="DejaVu Sans", fontsize=11]; edge[fontname="DejaVu Sans", fontsize=11, arrowhead=crow, arrowtail=tee, dir=both];
Employer[label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#f3f6fb"><tr><td bgcolor="#c9d8ef"><b>Работодатель</b></td></tr><tr><td align="left"><u>id</u> PK</td></tr><tr><td align="left">наименование</td></tr><tr><td align="left">ИНН (12 цифр)</td></tr><tr><td align="left">адрес, город</td></tr><tr><td align="left">контактное_лицо</td></tr><tr><td align="left">телефон, email</td></tr></table>>];
Vacancy[label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#f3f6fb"><tr><td bgcolor="#c9d8ef"><b>Вакансия</b></td></tr><tr><td align="left"><u>id</u> PK</td></tr><tr><td align="left">id_работодателя FK</td></tr><tr><td align="left">название, город</td></tr><tr><td align="left">требования (навыки)</td></tr><tr><td align="left">мин. опыт, лет</td></tr><tr><td align="left">заработная_плата</td></tr><tr><td align="left">статус</td></tr><tr><td align="left">дата_открытия, дата_закрытия</td></tr></table>>];
Applicant[label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#f3f6fb"><tr><td bgcolor="#c9d8ef"><b>Соискатель</b></td></tr><tr><td align="left"><u>id</u> PK</td></tr><tr><td align="left">ФИО</td></tr><tr><td align="left">телефон, email, город</td></tr><tr><td align="left">образование</td></tr><tr><td align="left">опыт_работы, лет</td></tr><tr><td align="left">навыки</td></tr><tr><td align="left">желаемая_зп</td></tr><tr><td align="left">файл_резюме</td></tr></table>>];
Selection[label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#f3f6fb"><tr><td bgcolor="#c9d8ef"><b>Подборка</b></td></tr><tr><td align="left"><u>id</u> PK</td></tr><tr><td align="left">id_вакансии FK</td></tr><tr><td align="left">id_соискателя FK</td></tr><tr><td align="left">id_рекрутера FK</td></tr><tr><td align="left">дата_создания</td></tr><tr><td align="left">статус, баллы совпадения</td></tr></table>>];
Stage[label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#f3f6fb"><tr><td bgcolor="#c9d8ef"><b>Этап_работы</b></td></tr><tr><td align="left"><u>id</u> PK</td></tr><tr><td align="left">id_подборки FK</td></tr><tr><td align="left">название_этапа</td></tr><tr><td align="left">дата</td></tr><tr><td align="left">комментарий</td></tr></table>>];
User[label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#f3f6fb"><tr><td bgcolor="#c9d8ef"><b>Пользователь</b></td></tr><tr><td align="left"><u>id</u> PK</td></tr><tr><td align="left">логин (уникальный)</td></tr><tr><td align="left">хэш_пароля</td></tr><tr><td align="left">роль</td></tr><tr><td align="left">ФИО</td></tr></table>>];
Report[label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#f3f6fb"><tr><td bgcolor="#c9d8ef"><b>Отчёт</b></td></tr><tr><td align="left"><u>id</u> PK</td></tr><tr><td align="left">id_пользователя FK</td></tr><tr><td align="left">тип</td></tr><tr><td align="left">дата_формирования</td></tr><tr><td align="left">параметры</td></tr></table>>];
Employer -> Vacancy [label="размещает\n1 : N"]; Vacancy -> Selection [label="1 : N"]; Applicant -> Selection [label="включается\n1 : N"];
User -> Selection [label="ведёт\n1 : N"]; Selection -> Stage [label="1 : N"]; User -> Report [label="формирует\n1 : N"];
}
